# Local development only. Do not reuse these credentials in production.
APP_ENV=development
POSTGRES_USER=ipo
POSTGRES_PASSWORD=ipo
POSTGRES_DB=ipo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ipo:ipo@localhost:5432/ipo
# Optional JSON array of server-managed Prometheus sources. Keep credentials local.
# PROMETHEUS_SOURCES=[{"id":"production-prometheus","name":"Production Prometheus","base_url":"https://prometheus.example.com","credentials":{"type":"bearer_token","token":"replace-me"}}]
# Optional Jira Cloud Alert provider. Keep the dedicated ordinary-user classic API token local.
# The bot needs Browse Projects and applicable issue-security visibility; Jira can silently omit
# inaccessible issues and enhanced search is eventually consistent. Scoped tokens, official
# Service Accounts, gateway/Cloud-ID routing, and OAuth are not supported.
# JIRA_ALERT_PROVIDER={"site_url":"https://example.atlassian.net/jira","email":"bot@example.invalid","api_token":"replace-me"}
