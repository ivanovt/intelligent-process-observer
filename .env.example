# Local development only. Do not reuse these credentials in production.
APP_ENV=development
POSTGRES_USER=ipo
POSTGRES_PASSWORD=ipo
POSTGRES_DB=ipo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ipo:ipo@localhost:5432/ipo
# Optional JSON array of server-managed Prometheus sources; omit it when none are configured.
# Each source requires a stable id, display name, base URL, and exactly one credential shape.
# Keep real values in the local/deployment environment; these examples are placeholders only.
# Bearer token example:
# PROMETHEUS_SOURCES=[{"id":"example-prometheus","name":"Example Prometheus","base_url":"https://prometheus.example.invalid/prometheus","credentials":{"type":"bearer_token","token":"replace-with-secret-token"}}]
# Basic authentication example:
# PROMETHEUS_SOURCES=[{"id":"example-prometheus","name":"Example Prometheus","base_url":"https://prometheus.example.invalid/prometheus","credentials":{"type":"basic_auth","username":"replace-with-reader-username","password":"replace-with-secret-password"}}]
# Optional Jira Cloud Alert provider. Supply this serialized JSON only in a local or deployment
# environment; the example is deliberately placeholder-only. Use a dedicated ordinary Atlassian
# user account and its classic/unscoped API token, not an official Service Account.
# Accepted site_url forms are https://<site>.atlassian.net and https://<site>.atlassian.net/jira;
# both derive the same pathless site origin for REST requests and issue links. The bot needs Browse
# Projects and applicable issue-security visibility for every selector. Jira can silently omit
# inaccessible issues, and enhanced search is eventually consistent. Scoped tokens, gateway/Cloud-ID
# routing, OAuth, Jira Service Management/Operations, and Opsgenie are not supported.
# JIRA_ALERT_PROVIDER={"site_url":"https://example.atlassian.net/jira","email":"bot@example.invalid","api_token":"replace-me"}
# Optional Observation Reasoning OpenRouter configuration. Keep the key local/deployment-only.
# OPENROUTER_API_KEY=replace-with-secret-key
# OBSERVATION_REASONING_MODEL=openai/gpt-5.6-terra
# OPENROUTER_REQUEST_TIMEOUT_SECONDS=120
# OBSERVATION_REASONING_MAX_OUTPUT_TOKENS=12288
# OPENROUTER_ALLOW_FALLBACKS=true
# OPENROUTER_PROVIDER_ORDER=[]
